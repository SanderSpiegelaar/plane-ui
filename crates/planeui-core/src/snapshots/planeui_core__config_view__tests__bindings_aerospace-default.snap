  alt-shift-semicolon [alt-shift-semicolon] editable String: mode service
mode "service" editable=true
  esc [esc] editable Array: reload-config -> mode main
  r [r] editable Array: flatten-workspace-tree -> mode main
    # reset layout
  f [f] editable Array: layout floating tiling -> mode main
    # Toggle between floating and tiling layout
  backspace [backspace] editable Array: close-all-windows-but-current -> mode main
  alt-shift-h [alt-shift-h] editable Array: join-with left -> mode main
  alt-shift-j [alt-shift-j] editable Array: join-with down -> mode main
  alt-shift-k [alt-shift-k] editable Array: join-with up -> mode main
  alt-shift-l [alt-shift-l] editable Array: join-with right -> mode main
